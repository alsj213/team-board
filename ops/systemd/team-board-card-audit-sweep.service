[Unit]
Description=team-board card-audit sweep (block malformed ready cards before dispatch)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/liu/project/team-board
Environment=PATH=/home/liu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u all_proxy PYTHONPATH=/home/liu/project/team-board/src /home/liu/project/team-board/.venv/bin/python -m team_board.cli card-audit --sweep --apply --limit 20 --db /home/liu/.hermes/kanban/boards/devteam/kanban.db
Nice=10
