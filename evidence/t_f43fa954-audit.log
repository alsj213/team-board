### --allow-file 坏行
$ PYTHONPATH=/workspace/team-board/src /usr/bin/python3 -m team_board.cli branch-audit --repo /tmp/tmp.BUX6vOhwg6/green --allow-file /tmp/tmp.BUX6vOhwg6/bad-allow.txt
rc=2
--- stdout: 空 ---
