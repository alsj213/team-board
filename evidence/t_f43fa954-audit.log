########## 验收 5 + 必修 1/2：rc2 边界矩阵 ##########
### --repo 空串
$ PYTHONPATH=/workspace/team-board/src /usr/bin/python3 -m team_board.cli branch-audit --repo 
rc=2
--- stdout: 空 ---
--- stderr（末 3 行） ---
错误: 仓库路径为空

### --repo 不存在
$ PYTHONPATH=/workspace/team-board/src /usr/bin/python3 -m team_board.cli branch-audit --repo /nonexistent-audit-path
rc=2
--- stdout: 空 ---
--- stderr（末 3 行） ---
错误: 仓库路径不存在: /nonexistent-audit-path

### --repo /tmp（非 git）
$ PYTHONPATH=/workspace/team-board/src /usr/bin/python3 -m team_board.cli branch-audit --repo /tmp
rc=2
--- stdout: 空 ---
--- stderr（末 3 行） ---
错误: 不是 git 工作树: /tmp

### --main-branch nope
$ PYTHONPATH=/workspace/team-board/src /usr/bin/python3 -m team_board.cli branch-audit --repo /tmp/tmp.BUX6vOhwg6/green --main-branch nope
rc=2
--- stdout: 空 ---
--- stderr（末 3 行） ---
错误: 主分支不存在（本地与 origin 都没有）: nope

### --branch 空串
$ PYTHONPATH=/workspace/team-board/src /usr/bin/python3 -m team_board.cli branch-audit --repo /tmp/tmp.BUX6vOhwg6/green --branch 
rc=2
--- stdout: 空 ---
--- stderr（末 3 行） ---
错误: --branch 不能为空

### --branch nosuchbranch
$ PYTHONPATH=/workspace/team-board/src /usr/bin/python3 -m team_board.cli branch-audit --repo /tmp/tmp.BUX6vOhwg6/green --branch nosuchbranch
rc=2
--- stdout: 空 ---
--- stderr（末 3 行） ---
错误: 分支不存在（本地与 origin 都没有）: nosuchbranch

### --bogus（argparse）
$ PYTHONPATH=/workspace/team-board/src /usr/bin/python3 -m team_board.cli branch-audit --repo /tmp/tmp.BUX6vOhwg6/green --bogus
